# App

NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_APP_NAME=LitMatrix

# Authentication

NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Public registration/login is the default (false). Set to true only for internal testing/private beta.
AUTH_ALLOWLIST_ENABLED=false
# Comma-separated list of allowed emails (used ONLY when AUTH_ALLOWLIST_ENABLED=true).
# Note: This is an application-level filter, NOT your Neon Console account email.
AUTH_ALLOWED_EMAILS=

# Database

DATABASE_URL=

# Gemini Provider

GEMINI_API_KEY=
GEMINI_MODEL=

# Zotero Local API

ZOTERO_LOCAL_API_URL=http://localhost:23119/api

# Zotero Web API

ZOTERO_WEB_API_BASE_URL=https://api.zotero.org
ZOTERO_API_KEY=
ZOTERO_USER_ID=
ZOTERO_LIBRARY_TYPE=user

# Antigravity Local Import

ANTIGRAVITY_OUTPUT_DIR=./antigravity_outputs
ANTIGRAVITY_IMPORT_ENABLED=true
